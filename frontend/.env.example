# URL base de la API REST (.NET). Sin barra final.
VITE_API_URL=http://localhost:5139

# true: usa mocks locales. false: llama a la API real.
VITE_USE_API_MOCK=false

# MapTiler Cloud — tiles del mapa de Ubicaciones (plan free).
